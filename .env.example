# =====================================================================
# INKLOOM AI â€” ENVIRONMENT CONFIGURATION & APPLICATION SECRETS TEMPLATE
# Copy this file to .env and insert your real API credentials
# =====================================================================

# 1. Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Backend Server Configuration
PORT=4000
NODE_ENV=development

# 3. Frontend Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# For a single Vercel deployment, set this to /api so the frontend uses the
# Express function deployed with the web app. Use the backend's public URL
# instead when deploying the Express service separately.

# 4. Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 5. ChromaDB Vector Store Configuration
CHROMA_URL=http://localhost:8000
