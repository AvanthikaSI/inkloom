{
  "name": "inkloom",
  "version": "1.0.0",
  "description": "Inkloom AI — Enterprise Brand Governance & Content Pre-publication Platform",
  "main": "apps/server/src/index.ts",
  "type": "module",
  "scripts": {
    "test": "npx tsx tests/test-pipeline.ts && npx tsx tests/test-agentic-workflow.ts && python services/vision-worker/test_worker.py",
    "test:worker": "python services/vision-worker/test_worker.py",
    "test:pipeline": "npx tsx tests/test-pipeline.ts",
    "test:agentic": "npx tsx tests/test-agentic-workflow.ts",
    "test:live": "npx tsx tests/live-server-test.ts",
    "test:multimodal": "npx tsx tests/test-chat-upload.ts",
    "server": "npx tsx apps/server/src/index.ts",
    "dev:server": "npx tsx watch apps/server/src/index.ts",
    "dev:web": "next dev apps/web -p 3000",
    "start:all": "node scripts/start-all.mjs",
    "start": "node scripts/start-all.mjs",
    "build:web": "next build apps/web",
    "start:web": "next start apps/web -p 3000"
  },
  "keywords": [
    "brand-governance",
    "langgraph",
    "groq",
    "chromadb",
    "supabase",
    "compliance"
  ],
  "author": "Inkloom Team",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.5.2",
    "@supabase/supabase-js": "^2.118.0",
    "autoprefixer": "^10.6.1",
    "chromadb": "^3.5.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "next": "^14.2.35",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
